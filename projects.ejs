<%- include('partials/header') %>
<main>
  <h2>Projects</h2>
  <div class="projects-grid">
    <% projects.forEach(project => { %>
      <article class="project-card">
        <div>
          <h3><%= project.title %></h3>
          <p><%= project.description %></p>
          <ul class="project-tech">
            <% project.technologies.forEach(technology => { %><li class="skill-badge"><%= technology %></li><% }); %>
          </ul>
        </div>
        <a href="<%= project.link %>" target="_blank" class="btn-link">View Source &rarr;</a>
      </article>
    <% }); %>
  </div>
</main>
<%- include('partials/footer') %>
